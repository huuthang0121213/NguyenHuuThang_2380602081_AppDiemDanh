# ==========================================
# CẤU HÌNH API BASE URL CHO FLUTTER
# ==========================================

# 1. Khi chạy trên Android Emulator (máy ảo Android):
API_BASE_URL=http://10.0.2.2:5000/api

# 2. Khi chạy trên Điện thoại thật (cùng mạng Wi-Fi với máy tính):
# Thay <IP_LAN_CUA_MAY_TINH> bằng IP mạng nội bộ của bạn (ví dụ: 192.168.1.15)
# API_BASE_URL=http://192.168.1.15:5000/api

# 3. Khi chạy trên Windows Desktop hoặc Chrome Web:
# API_BASE_URL=http://localhost:5000/api
